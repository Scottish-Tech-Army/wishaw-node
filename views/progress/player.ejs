<%- include('../partials/header') %>
<%- include('../partials/nav') %>
<main id="main-content" class="main-with-sidebar page-shell">
  <section class="page-hero">
    <div class="page-hero-grid">
      <div class="page-hero-content">
        <span class="eyebrow">Player Progress</span>
        <h1>🎮 <%= player.displayName %></h1>
        <p class="page-hero-intro">A clean staff view of this player's current standing, their recent recognition, and the badge tracks already taking shape.</p>
        <div class="page-chip-row">
          <div class="page-chip">
            <span>Total Points</span>
            <strong><%= progress.totalXp %> XP</strong>
          </div>
          <div class="page-chip">
            <span>Group</span>
            <strong><%= player.groupName || '—' %></strong>
          </div>
          <div class="page-chip">
            <span>Status</span>
            <strong><%= player.active ? 'Active' : 'Inactive' %></strong>
          </div>
        </div>
      </div>
      <div class="page-hero-panel player-showcase">
        <%- include('../partials/player-media', { player: player, size: 'xl', shape: player.profileImageKind === 'avatar' ? 'circle' : 'panel' }) %>
        <div class="player-showcase-copy">
          <h2>Use this view to guide next steps.</h2>
          <p>Read the story quickly before the session starts, then look for the next challenge or support move once the points land.</p>
          <div class="stack-compact">
            <span class="info-pill"><span>Centre</span><strong><%= player.centreName || '—' %></strong></span>
            <span class="info-pill"><span>Status</span><strong><%= player.active ? 'Active' : 'Inactive' %></strong></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="profile-info card profile-overview-card">
    <div class="profile-summary-grid">
      <div class="profile-summary-item">
        <span>Group</span>
        <strong><%= player.groupName || '—' %></strong>
      </div>
      <div class="profile-summary-item">
        <span>Centre</span>
        <strong><%= player.centreName || '—' %></strong>
      </div>
      <div class="profile-summary-item">
        <span>Status</span>
        <strong><span class="status-badge status-<%= player.active ? 'active' : 'inactive' %>"><%= player.active ? 'Active' : 'Inactive' %></span></strong>
      </div>
    </div>
  </div>

  <div class="section-heading">
    <h2>Badge Progress</h2>
    <p>Each category below turns session moments into a readable progression trail.</p>
  </div>
  <% if (useMock) { %>
    <div class="badge-grid">
      <% badgeCategories.forEach(function(cat) { %>
        <% var catData = progress.byCategory[cat.id]; %>
        <div class="badge-card" style="border-top: 4px solid <%= cat.color %>">
          <div class="badge-card-header">
            <span class="badge-icon"><%= cat.icon %></span>
            <h3><%= cat.name %></h3>
          </div>
          <div class="badge-points"><%= catData ? catData.points : 0 %> pts</div>
          <div class="badge-progress-bar">
            <div class="badge-progress-fill" style="width: <%= Math.min(100, ((catData ? catData.points : 0) / 500) * 100) %>%; background: <%= cat.color %>"></div>
          </div>
          <% if (catData && catData.awards.length > 0) { %>
            <ul class="badge-awards">
              <% catData.awards.forEach(function(a) { %>
                <li><%= a.challengeName %> — <strong><%= a.pointsAwarded %> pts</strong> <small>(<%= a.awardedAt %>)</small></li>
              <% }); %>
            </ul>
          <% } else { %>
            <p class="empty-text">No awards have landed here yet.</p>
          <% } %>
        </div>
      <% }); %>
    </div>

    <div class="section-heading">
      <h2>Recent Awards</h2>
      <p>The latest recognised moments appear first so staff can review momentum quickly.</p>
    </div>
    <% if (progress.awards.length === 0) { %>
      <div class="empty-state">
        <strong>No awards recorded yet.</strong>
        <p>Once challenges start being awarded, the latest entries will appear here.</p>
      </div>
    <% } else { %>
      <table class="data-table">
        <thead><tr><th>Challenge</th><th>Module</th><th>Category</th><th>Points</th><th>Date</th></tr></thead>
        <tbody>
          <% progress.awards.sort(function(a,b) { return b.awardedAt.localeCompare(a.awardedAt); }).forEach(function(a) { %>
            <% var cat = badgeCategories.find(function(c) { return c.id === a.badgeCategory; }); %>
            <tr>
              <td><%= a.challengeName %></td>
              <td><%= a.moduleName %></td>
              <td><span class="badge" style="background: <%= cat ? cat.color : '#ccc' %>"><%= cat ? cat.name : a.badgeCategory %></span></td>
              <td><strong><%= a.pointsAwarded %></strong></td>
              <td><%= a.awardedAt %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  <% } else if (!progress.categories || progress.categories.length === 0) { %>
    <div class="empty-state">
      <strong>No badge progress has been recorded yet.</strong>
      <p>This live record will populate as soon as recognised progress reaches the backend.</p>
    </div>
  <% } else { %>
    <table class="data-table">
      <thead><tr><th>Category</th><th>Legacy</th><th>Earned</th><th>Total</th><th>Level</th></tr></thead>
      <tbody>
        <% progress.categories.forEach(function(category) { %>
          <tr>
            <td><strong><%= category.name %></strong></td>
            <td><%= category.legacyPoints %></td>
            <td><%= category.earnedPoints %></td>
            <td><strong><%= category.points %></strong></td>
            <td><%= category.currentLevel || '—' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</main>
<%- include('../partials/footer') %>
