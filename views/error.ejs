<%- include('partials/header') %>
<%- include('partials/nav') %>
<main id="main-content" class="<%= currentUser ? 'main-with-sidebar' : 'main-full' %>">
  <div class="error-page">
    <span class="eyebrow">Status <%= error && error.status ? error.status : 'Error' %></span>
    <h1><%= title || 'Something interrupted the flow' %></h1>
    <p class="error-message"><%= message %></p>
    <% if (typeof details !== 'undefined' && details) { %>
      <p class="error-details"><%= details %></p>
    <% } %>
    <% if (typeof actions !== 'undefined' && actions && actions.length) { %>
      <div class="error-actions">
        <% actions.forEach(function (action) { %>
          <a href="<%= action.href %>" class="<%= action.className || 'btn btn-secondary' %>"><%= action.label %></a>
        <% }); %>
      </div>
    <% } else { %>
      <a href="/" class="btn btn-primary">Return Home</a>
    <% } %>
    <% if (error && error.stack) { %>
      <pre class="error-stack"><%= error.stack %></pre>
    <% } %>
  </div>
</main>
<%- include('partials/footer') %>
